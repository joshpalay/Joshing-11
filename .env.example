# =============================================================
# Joshing v11 — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to git.
# =============================================================

# ── Database (Supabase — used as Postgres only) ───────────────
# Pooled connection — used by the app at runtime. Must be the Supavisor
# transaction-mode pooler (host: <region>.pooler.supabase.com, port 6543).
# Transaction mode releases the backend connection between queries, which is
# what lets a small backend pool serve many concurrent serverless instances.
# Session mode (port 5432 on the pooler) will exhaust connections on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE"

# Direct connection (db.<project>.supabase.co, port 5432) — used by the
# instrumentation migrator on boot. Migrations run multi-statement
# transactions that transaction-mode poolers reject, so they must bypass
# the pooler entirely.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ── Anthropic ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ── Auth ──────────────────────────────────────────────────────
# 32+ random bytes, base64-encoded.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=""
# Optional alias used by some platforms/tooling.
AUTH_SECRET=""

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Phase 5+ only (Twilio — do not add until Phase 5) ────────
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_MESSAGING_SERVICE_SID=""
