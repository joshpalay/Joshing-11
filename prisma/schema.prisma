// Joshing — Prisma Schema (MVP private groups)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum GameSetup {
  know_me
  know_me_plus
  open
}

enum Category {
  music
  literature
  history
  film_tv
  sport
  science
  philosophy
  pop_culture
  language
  general_knowledge
}

enum QuestionVisibility {
  private
  public
}

enum PublicStatus {
  not_scored
  eligible_pending
  opted_out
  migrated
  rejected
}

enum AnswerSource {
  llm_suggested
  creator_written
  llm_edited
}

enum QuestionStatus {
  verified
  unverified
}

enum QuestionType {
  factual
  personal
  ambiguous
  factual_uncertain
}

enum GradeDisputeStatus {
  pending
  reviewed
  alternative_added
  dismissed
}

enum DifficultyEstimate {
  accessible
  moderate
  specialist
}

enum ReactionCanned {
  always_knew
  got_me
  of_course_you
  never_heard
  need_to_talk
  didnt_know_tell_me
  need_story
  adding_to_list
  knew_i_wouldnt
}

enum CreatorResponseCanned {
  knew_youd_get_it
  surprised_you_knew
  just_for_you
  story_here
}

enum SmsMessageType {
  otp
  daily_questions
  daily_questions_batched
  invitation
  star_notification
  correct_answer_notification
  question_reaction
  creator_reaction_response
  game_complete
  game_summary_ready
  expiry_reminder
  incognito_round_invitation
  anniversary_milestone
  creator_note_prompt
}

enum AnswerResult {
  correct
  wrong
  expired
}

/// Scoring state for mastery credit (B9). Set at insert; never updated.
enum AnswerState {
  first_correct
  first_correct_after_wrong
  repeat_correct
  incorrect
}

enum AssignmentStatus {
  pending
  answered
  expired
}

enum MemberStatus {
  active
  removed
  left
}

enum GroupStatus {
  active
  between_games
  dormant
  archived
}

enum GameStatus {
  seeding
  active
  completed
}

enum SmsOptIn {
  opted_in
  opted_out
  not_asked
}

enum ThemePreference {
  quiet_atelier
  sunday_margins
  parlor_index
}

enum SubscriptionPlan {
  free
  plus_monthly
  plus_yearly
}

enum PortraitVisibility {
  public
  private
}

enum MasteryTier {
  establishing
  familiar
  solid
  mastery
}

enum MasterySourceType {
  live_correct
  authored
  author_credit
  curator_credit
  catchup_correct
  domain_merged
}

enum FeedbackSignal {
  thumbs_up
  thumbs_down
}

enum ChallengeLinkStatus {
  active
  deactivated
}

enum ChallengePlayState {
  in_progress
  completed
  abandoned
}

enum ChallengeMasteryTierSnapshot {
  solid
  mastery
}

enum ChallengeGradeResult {
  correct
  wrong
}

// ─────────────────────────────────────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                String           @id @default(cuid())
  phone_number      String           @unique
  email             String?          @unique
  display_name      String?
  phone_verified    Boolean          @default(false)
  timezone          String           @default("America/New_York")
  is_subscriber     Boolean          @default(false)
  preferred_theme   ThemePreference  @default(quiet_atelier)
  subscription_plan SubscriptionPlan @default(free)
  sms_opt_in        SmsOptIn         @default(not_asked)
  sms_reminder_time Int?
  portrait_visibility PortraitVisibility @default(public)
  knowledge_card_share_token String? @unique
  knowledge_card_share_expires_at DateTime?
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  questions             Question[]
  question_bank         UserQuestionBank[]
  group_members         GroupMember[]
  groups_started        Group[]               @relation("GameStarter")
  answers               Answer[]
  daily_assignments     DailyAssignment[]
  daily_sessions        DailySession[]
  user_question_history UserQuestionHistory[]
  star_votes            StarVote[]
  sessions              UserSession[]
  reactions_given       QuestionReaction[]    @relation("ReactionsGiven")
  reactions_received    QuestionReaction[]    @relation("ReactionsReceived")
  player_masteries      PlayerMastery[]
  mastery_events        MasteryEvent[]
  challenges_created    Challenge[]              @relation("ChallengeCreator")
  challenge_sessions    ChallengeSession[]       @relation("ChallengeSessionUser")
  challenge_conversions ChallengeSession[]       @relation("ChallengeSessionConverted")
  app_notifications     AppNotification[]
  profile_domain_visibility ProfileDomainVisibility[]
  ceremony_progress     CeremonyProgress[]
  generated_questions   GeneratedQuestion[]
  question_feedbacks    QuestionFeedback[]
  daily_queues          DailyQueue[]
  skipped_daily_questions SkippedDailyQuestion[]
  daily_preference      DailyPreference?
  user_domain_difficulties UserDomainDifficulty[]
  domain_exclusions     UserDomainExclusion[]

  @@index([phone_number])
}

model UserSession {
  id         String   @id @default(cuid())
  user_id    String
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([token])
  @@index([user_id])
}

model OtpCode {
  id           String   @id @default(cuid())
  phone_number String
  code         String
  expires_at   DateTime
  created_at   DateTime @default(now())

  @@index([phone_number])
}

// ─────────────────────────────────────────────────────────────────────────────
// QUESTIONS
// ─────────────────────────────────────────────────────────────────────────────

model Question {
  id                        String              @id @default(cuid())
  creator_id                String
  source_question_id        String?
  source_creator_id         String?
  question_text             String
  // Short moment hint (2–6 words, ~30 chars max); validated in app
  breadcrumb_context        String              @default("")
  answer_text               String
  // Cached factual explanation for end-of-session reflection (not personalized)
  factual_explanation       String?
  accepted_alternatives     String[]            @default([])
  answer_source             AnswerSource?
  question_type             QuestionType        @default(factual)
  minimum_required          Int?
  category                  Category            @default(general_knowledge)
  broad_category            String?
  subcategory               String?
  canonical_subcategory     String?
  category_overridden       Boolean             @default(false)
  creator_note              String?
  difficulty_estimate       DifficultyEstimate?
  llm_difficulty            DifficultyEstimate?
  calibrated_difficulty     DifficultyEstimate?
  correct_rate              Float?
  explainer_brief           String?
  explainer_full            String?
  // Per-result-type explainer cache (PRD §9.4: cache key = question_id + result_type)
  explainer_brief_correct   String?
  explainer_full_correct    String?
  explainer_brief_wrong     String?
  explainer_full_wrong      String?
  explainer_brief_expired   String?
  explainer_full_expired    String?
  short_label               String?
  status                    QuestionStatus      @default(verified)
  visibility                QuestionVisibility  @default(public)
  public_status             PublicStatus        @default(not_scored)
  public_eligibility_score  Float?
  public_eligibility_reason String?
  asked_count               Int                 @default(0)
  correct_count             Int                 @default(0)
  created_at                DateTime            @default(now())
  updated_at                DateTime            @updatedAt
  deleted_at                DateTime?

  creator           User                  @relation(fields: [creator_id], references: [id])
  audience_tags     QuestionAudienceTag[]
  game_questions    GameQuestion[]
  daily_assignments DailyAssignment[]
  answers           Answer[]
  user_history      UserQuestionHistory[]
  star_votes        StarVote[]
  reactions         QuestionReaction[]
  bank_references   UserQuestionBank[]
  challenge_questions ChallengeQuestion[]
  challenge_answers   ChallengeAnswer[]
  mastery_events    MasteryEvent[]
  feedbacks         QuestionFeedback[]
  skip_events       SkippedDailyQuestion[]

  @@index([creator_id])
  @@index([creator_id, deleted_at])
  @@index([creator_id, visibility])
  @@index([broad_category])
  @@index([canonical_subcategory])
  @@index([source_question_id])
  @@index([source_creator_id])
}

model QuestionAudienceTag {
  id          String   @id @default(cuid())
  question_id String
  creator_id  String
  tag         String
  created_at  DateTime @default(now())

  question Question @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@index([creator_id])
  @@index([question_id])
}

model UserQuestionBank {
  id                      String   @id @default(cuid())
  user_id                 String
  question_id             String
  added_at                DateTime @default(now())
  added_from_context_type String?
  added_from_context_id   String?

  user     User     @relation(fields: [user_id], references: [id])
  question Question @relation(fields: [question_id], references: [id])

  @@unique([user_id, question_id])
  @@index([user_id])
  @@index([question_id])
}

// ─────────────────────────────────────────────────────────────────────────────
// GROUPS AND GAMES
// ─────────────────────────────────────────────────────────────────────────────

model Group {
  id                         String      @id @default(cuid())
  name                       String
  tagline                    String?
  game_starter_id            String
  game_mode                  GameSetup   @default(know_me)
  minimum_questions_required Int         @default(5)
  status                     GroupStatus @default(active)
  games_completed            Int         @default(0)
  created_at                 DateTime    @default(now())
  updated_at                 DateTime    @updatedAt

  game_starter      User              @relation("GameStarter", fields: [game_starter_id], references: [id])
  members           GroupMember[]
  games             Game[]
  game_questions    GameQuestion[]
  invite_links      InviteLink[]
  daily_assignments DailyAssignment[]
  daily_sessions    DailySession[]

  @@index([game_starter_id])
}

model GroupMember {
  id                            String       @id @default(cuid())
  group_id                      String
  user_id                       String
  joined_at                     DateTime     @default(now())
  invited_by                    String?
  status                        MemberStatus @default(active)
  games_completed               Int          @default(0)
  questions_contributed_total   Int          @default(0)
  joining_contribution_complete Boolean      @default(false)
  open_round_contributed        Boolean      @default(false)

  group Group @relation(fields: [group_id], references: [id])
  user  User  @relation(fields: [user_id], references: [id])

  @@unique([group_id, user_id])
  @@index([group_id])
  @@index([user_id])
}

model Game {
  id              String     @id @default(cuid())
  group_id        String
  game_number     Int
  status          GameStatus @default(seeding)
  archived_at     DateTime?
  archived_by     String?
  started_at      DateTime?
  completed_at    DateTime?
  total_questions Int?
  created_at      DateTime   @default(now())

  group             Group             @relation(fields: [group_id], references: [id])
  group_questions   GameQuestion[]
  daily_assignments DailyAssignment[]
  daily_sessions    DailySession[]
  ceremony_progress CeremonyProgress[]

  @@index([group_id])
  @@index([group_id, status])
  @@index([group_id, archived_at])
}

model GameQuestion {
  id          String   @id @default(cuid())
  game_id     String
  group_id    String
  question_id String
  added_at    DateTime @default(now())
  added_by    String

  game     Game     @relation(fields: [game_id], references: [id])
  group    Group    @relation(fields: [group_id], references: [id])
  question Question @relation(fields: [question_id], references: [id])

  is_opening_question Boolean @default(false)
  position            Int?

  @@unique([game_id, question_id])
  @@index([game_id])
  @@index([game_id, position])
  @@index([group_id, question_id])
  @@index([question_id])
}

// ─────────────────────────────────────────────────────────────────────────────
// DAILY SESSIONS AND ASSIGNMENTS
// ─────────────────────────────────────────────────────────────────────────────

model DailySession {
  id                         String    @id @default(cuid())
  user_id                    String
  group_id                   String
  game_id                    String
  session_date               DateTime  @db.Date
  questions_assigned         Int       @default(5)
  questions_answered         Int       @default(0)
  questions_correct          Int       @default(0)
  questions_expired          Int       @default(0)
  share_card_text_copied     Boolean   @default(false)
  share_card_link_shared     Boolean   @default(false)
  share_card_link_token      String?   @unique
  share_card_link_expires_at DateTime?
  created_at                 DateTime  @default(now())

  user        User              @relation(fields: [user_id], references: [id])
  group       Group             @relation(fields: [group_id], references: [id])
  game        Game              @relation(fields: [game_id], references: [id])
  assignments DailyAssignment[]

  @@unique([user_id, group_id, game_id, session_date])
  @@index([user_id, session_date])
  @@index([group_id, session_date])
  @@index([game_id, session_date])
}

model DailyAssignment {
  id               String           @id @default(cuid())
  daily_session_id String?
  user_id          String
  group_id         String
  game_id          String
  question_id      String
  assignment_date  DateTime         @db.Date
  expires_at       DateTime
  status           AssignmentStatus @default(pending)
  position         Int
  daily_link_token      String?          @unique
  catch_up_dismissed    Boolean          @default(false)
  created_at            DateTime         @default(now())

  daily_session DailySession? @relation(fields: [daily_session_id], references: [id])
  user          User          @relation(fields: [user_id], references: [id])
  group         Group         @relation(fields: [group_id], references: [id])
  game          Game          @relation(fields: [game_id], references: [id])
  question      Question      @relation(fields: [question_id], references: [id])
  answer        Answer?

  @@index([user_id, assignment_date])
  @@index([user_id, game_id])
  @@index([user_id, game_id, question_id])
  @@index([user_id, group_id, game_id, assignment_date])
  @@index([user_id, group_id, game_id, status, expires_at])
  @@index([game_id, user_id, status])
  @@index([group_id, game_id, assignment_date, user_id])
  @@index([user_id, game_id, status, expires_at])
  @@index([user_id, status])
  @@index([status, expires_at])
  @@index([game_id])
  @@index([group_id, question_id])
  @@index([daily_session_id])
}

// ─────────────────────────────────────────────────────────────────────────────
// ANSWERS
// ─────────────────────────────────────────────────────────────────────────────

model Answer {
  id                  String       @id @default(cuid())
  user_id             String
  question_id         String
  group_id            String
  game_id             String
  daily_assignment_id String       @unique
  submitted_answer    String?
  result              AnswerResult
  answer_state        AnswerState
  catch_up            Boolean      @default(false)
  answered_at         DateTime?    @default(now())
  disputed            Boolean      @default(false)
  response_time_ms    Int?
  question_presented_at DateTime?

  user             User              @relation(fields: [user_id], references: [id])
  question         Question          @relation(fields: [question_id], references: [id])
  daily_assignment DailyAssignment   @relation(fields: [daily_assignment_id], references: [id])
  reaction         QuestionReaction?
  mastery_event    MasteryEvent?

  @@index([user_id, question_id])
  @@index([question_id, result])
  @@index([game_id, user_id])
  @@index([group_id, game_id])
  @@index([group_id, game_id, result])
}

// ─────────────────────────────────────────────────────────────────────────────
// MASTERY
// ─────────────────────────────────────────────────────────────────────────────

model PlayerMastery {
  id                    String      @id @default(cuid())
  user_id               String
  canonical_subcategory String
  broad_category        String?
  total_points          Float       @default(0)
  tier                  MasteryTier @default(establishing)
  tier_reached_at       DateTime?
  season_points_start   Float       @default(0)
  updated_at            DateTime    @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@unique([user_id, canonical_subcategory])
  @@index([user_id])
  @@index([canonical_subcategory])
  @@map("PLAYER_MASTERY")
}

model MasteryEvent {
  id                    String            @id @default(cuid())
  user_id               String
  canonical_subcategory String
  source_type           MasterySourceType
  // Nullable to support B9 personal-daily bot-generated questions which
  // have no canonical Question row. Group-game writes always set this.
  question_id           String?
  answered_by_user_id   String?
  answer_id             String?           @unique
  base_points           Int               @default(0)
  weight                Float             @default(0)
  awarded_points        Float             @default(0)
  answer_state          AnswerState?
  session_context       String?
  metadata              Json?
  created_at            DateTime          @default(now())

  user     User      @relation(fields: [user_id], references: [id])
  question Question? @relation(fields: [question_id], references: [id])
  answer   Answer?   @relation(fields: [answer_id], references: [id], onDelete: SetNull)

  @@unique([source_type, question_id, answered_by_user_id])
  @@index([user_id])
  @@index([canonical_subcategory])
  @@index([question_id])
  @@index([answered_by_user_id])
  @@map("MASTERY_EVENTS")
}


model ProfileDomainVisibility {
  id                    String   @id @default(cuid())
  user_id               String
  canonical_subcategory String
  domain                String
  visibility            String   @default("public")
  is_visible            Boolean  @default(true)
  updated_at            DateTime @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, canonical_subcategory])
  @@unique([user_id, domain])
  @@index([user_id])
  @@map("PROFILE_DOMAIN_VISIBILITY")
}

// ─────────────────────────────────────────────────────────────────────────────
// DEDUPLICATION INDEX
// ─────────────────────────────────────────────────────────────────────────────

model UserQuestionHistory {
  id                String        @id @default(cuid())
  user_id           String
  question_id       String
  first_assigned_at DateTime      @default(now())
  answered_at       DateTime?
  result            AnswerResult?

  user     User     @relation(fields: [user_id], references: [id])
  question Question @relation(fields: [question_id], references: [id])

  @@unique([user_id, question_id])
  @@index([user_id, question_id])
}

// ─────────────────────────────────────────────────────────────────────────────
// STARS
// ─────────────────────────────────────────────────────────────────────────────

model StarVote {
  id          String   @id @default(cuid())
  user_id     String
  question_id String
  group_id    String?
  game_id     String
  voted_at    DateTime @default(now())

  user     User     @relation(fields: [user_id], references: [id])
  question Question @relation(fields: [question_id], references: [id])

  @@unique([user_id, question_id, game_id])
  @@index([question_id])
  @@index([user_id])
}

// ─────────────────────────────────────────────────────────────────────────────
// INTELLECTUAL ALIGNMENT
// ─────────────────────────────────────────────────────────────────────────────

model CompatibilityScore {
  id                          String   @id @default(cuid())
  knower_id                   String
  subject_id                  String
  group_id                    String
  questions_actively_answered Int      @default(0)
  questions_correct           Int      @default(0)
  score_percent               Float?
  last_updated                DateTime @default(now())

  @@unique([knower_id, subject_id, group_id])
  @@index([knower_id, group_id])
  @@index([subject_id, group_id])
}

// ─────────────────────────────────────────────────────────────────────────────
// QUESTION REACTIONS (8.10b)
// ─────────────────────────────────────────────────────────────────────────────

model QuestionReaction {
  id                   String                 @id @default(cuid())
  answerer_id          String
  creator_id           String
  question_id          String
  game_id              String
  answer_id            String                 @unique
  canned_response      ReactionCanned?
  note                 String?
  creator_response     CreatorResponseCanned?
  creator_responded_at DateTime?
  parent_reaction_id   String?
  created_at           DateTime               @default(now())

  question      Question @relation(fields: [question_id], references: [id])
  answerer_user User     @relation("ReactionsGiven", fields: [answerer_id], references: [id])
  creator_user  User     @relation("ReactionsReceived", fields: [creator_id], references: [id])
  answer        Answer   @relation(fields: [answer_id], references: [id])

  @@index([answerer_id])
  @@index([creator_id])
  @@index([question_id])
  @@index([game_id])
}

// ─────────────────────────────────────────────────────────────────────────────
// GRADE DISPUTES
// ─────────────────────────────────────────────────────────────────────────────

model GradeDispute {
  id               String             @id @default(cuid())
  answer_id        String             @unique
  question_id      String
  creator_id       String
  submitted_answer String
  canonical_answer String
  status           GradeDisputeStatus @default(pending)
  created_at       DateTime           @default(now())
  reviewed_at      DateTime?

  @@index([question_id])
  @@index([creator_id])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// INVITE LINKS
// ─────────────────────────────────────────────────────────────────────────────

model InviteLink {
  id                   String    @id @default(cuid())
  group_id             String
  game_id              String
  created_by           String
  code                 String    @unique
  phone_number         String?
  intended_for_user_id String?
  used_count           Int       @default(0)
  expires_at           DateTime?
  created_at           DateTime  @default(now())

  group Group @relation(fields: [group_id], references: [id])

  @@index([code])
  @@index([group_id])
  @@index([intended_for_user_id])
}

// ─────────────────────────────────────────────────────────────────────────────
// PUBLIC POOL (Phase 2 — schema built now, UI deferred)
// ─────────────────────────────────────────────────────────────────────────────

model FlagReport {
  id          String   @id @default(cuid())
  question_id String
  reporter_id String
  reason      String
  created_at  DateTime @default(now())
  resolved    Boolean  @default(false)

  @@index([question_id])
  @@index([resolved])
}

// ─────────────────────────────────────────────────────────────────────────────
// SMS LOG (PRD Section 11 — never contains answer text or question content)
// ─────────────────────────────────────────────────────────────────────────────

model SmsLog {
  id           String         @id @default(cuid())
  user_id      String?
  phone_number String?
  message_type SmsMessageType
  sent_at      DateTime       @default(now())

  @@index([user_id])
  @@index([phone_number])
  @@index([message_type, sent_at])
}

// ─────────────────────────────────────────────────────────────────────────────
// PHASE 2 — schema in MVP, UI deferred
// ─────────────────────────────────────────────────────────────────────────────

model PlayerSubscription {
  id            String   @id @default(cuid())
  subscriber_id String
  creator_id    String
  created_at    DateTime @default(now())

  @@unique([subscriber_id, creator_id])
  @@index([subscriber_id])
  @@index([creator_id])
}

model PublicRun {
  id                  String    @id @default(cuid())
  user_id             String
  started_at          DateTime  @default(now())
  ended_at            DateTime?
  questions_attempted Int       @default(0)
  questions_correct   Int       @default(0)
  questions_skipped   Int       @default(0)
  strikes             Int       @default(0)
  share_card_token    String?   @unique

  @@index([user_id])
  @@index([started_at])
}

// ─────────────────────────────────────────────────────────────────────────────
// GROUP KNOWLEDGE MAP (PRD §8.18 — per-group question mastery cache)
// ─────────────────────────────────────────────────────────────────────────────

model GroupKnowledgeMap {
  id                    String   @id @default(cuid())
  group_id              String
  user_id               String
  game_id               String
  questions_contributed Int      @default(0)
  stars_earned          Int      @default(0)
  category_signature    String[] @default([])
  last_updated          DateTime @default(now()) @updatedAt

  @@unique([group_id, user_id, game_id])
  @@index([group_id])
  @@index([user_id])
}

// ─────────────────────────────────────────────────────────────────────────────
// EXPERT CHALLENGES (B7 — PRD §8.28)
// ─────────────────────────────────────────────────────────────────────────────

model Challenge {
  id                      String                     @id @default(cuid())
  creator_id              String
  challenge_token         String                     @unique @db.VarChar(32)
  name                    String                     @db.VarChar(60)
  canonical_subcategory   String
  broad_category          String?
  creator_mastery_tier    ChallengeMasteryTierSnapshot
  question_count          Int
  status                  ChallengeLinkStatus        @default(active)
  public_discovery        Boolean                    @default(false)
  follower_count          Int                        @default(0)
  featured                Boolean                    @default(false)
  created_at              DateTime                   @default(now())
  updated_at              DateTime                   @updatedAt

  creator   User                @relation("ChallengeCreator", fields: [creator_id], references: [id])
  questions ChallengeQuestion[]
  sessions  ChallengeSession[]

  @@index([creator_id])
  @@index([challenge_token])
}

model ChallengeQuestion {
  id                     String              @id @default(cuid())
  challenge_id           String
  question_id            String
  position               Int
  question_text_snapshot String
  answer_text_snapshot   String
  difficulty_snapshot    DifficultyEstimate?

  challenge Challenge        @relation(fields: [challenge_id], references: [id], onDelete: Cascade)
  question  Question         @relation(fields: [question_id], references: [id])
  answers   ChallengeAnswer[]

  @@unique([challenge_id, position])
  @@index([challenge_id])
}

model ChallengeSession {
  id                      String             @id @default(cuid())
  challenge_id            String
  user_id                 String?
  challenge_session_token String             @unique @db.VarChar(64)
  question_queue_ids      String[]           @default([])
  skipped_once_ids        String[]           @default([])
  started_at              DateTime           @default(now())
  completed_at            DateTime?
  questions_answered      Int                @default(0)
  questions_correct       Int                @default(0)
  status                  ChallengePlayState @default(in_progress)
  converted_to_account    Boolean            @default(false)
  converted_user_id       String?

  challenge      Challenge         @relation(fields: [challenge_id], references: [id])
  user           User?             @relation("ChallengeSessionUser", fields: [user_id], references: [id])
  converted_user User?             @relation("ChallengeSessionConverted", fields: [converted_user_id], references: [id])
  answers        ChallengeAnswer[]

  @@index([challenge_id])
  @@index([challenge_session_token])
}

model ChallengeAnswer {
  id                    String               @id @default(cuid())
  challenge_session_id  String
  challenge_question_id String
  question_id           String
  submitted_answer      String?
  result                ChallengeGradeResult
  answered_at           DateTime             @default(now())

  session            ChallengeSession @relation(fields: [challenge_session_id], references: [id], onDelete: Cascade)
  challenge_question ChallengeQuestion @relation(fields: [challenge_question_id], references: [id])
  question           Question         @relation(fields: [question_id], references: [id])

  @@index([challenge_session_id])
  @@index([challenge_question_id])
}

model AppNotification {
  id           String    @id @default(cuid())
  user_id      String
  type         String
  message      String
  action_label String?
  action_url   String?
  dedupe_key   String?   @unique
  read_at      DateTime?
  created_at   DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([created_at])
}

model CeremonyProgress {
  id             String   @id @default(cuid())
  user_id        String
  game_id        String
  act1_viewed_at DateTime?
  act2_viewed_at DateTime?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  game Game @relation(fields: [game_id], references: [id], onDelete: Cascade)

  @@unique([user_id, game_id])
  @@index([user_id])
  @@index([game_id])
}

// ─────────────────────────────────────────────────────────────────────────────
// B9 — PERSONAL DAILY MODE
// ─────────────────────────────────────────────────────────────────────────────

model GeneratedQuestion {
  id                    String            @id @default(cuid())
  user_id               String
  canonical_subcategory String
  broad_category        String
  question_text         String
  answer                String
  explainer             String
  difficulty_estimate   String
  base_points           Int
  created_at            DateTime          @default(now())
  expires_at            DateTime
  used_in_queue         Boolean           @default(false)

  user     User              @relation(fields: [user_id], references: [id])
  feedback QuestionFeedback?
  skip_events SkippedDailyQuestion[]

  @@index([user_id])
  @@index([user_id, used_in_queue])
}

model QuestionFeedback {
  id                    String            @id @default(cuid())
  user_id               String
  question_id           String?
  generated_question_id String?           @unique
  signal                FeedbackSignal
  created_at            DateTime          @default(now())

  user               User               @relation(fields: [user_id], references: [id])
  question           Question?          @relation(fields: [question_id], references: [id])
  generated_question GeneratedQuestion? @relation(fields: [generated_question_id], references: [id])

  @@unique([user_id, question_id])
  @@unique([user_id, generated_question_id])
  @@index([user_id])
  @@index([question_id])
}

model DailyQueue {
  id         String   @id @default(cuid())
  user_id    String
  queue_date DateTime @db.Date
  slots      Json
  created_at DateTime @default(now())

  user         User                   @relation(fields: [user_id], references: [id])
  skip_events  SkippedDailyQuestion[]

  @@unique([user_id, queue_date])
  @@index([user_id])
}

// Persistent user preferences for Personal Daily — survives across days.
// Applied when building a new queue (today's existing queue is never rebuilt).
model DailyPreference {
  id                    String   @id @default(cuid())
  user_id               String   @unique
  user                  User     @relation(fields: [user_id], references: [id])
  friend_ids            String[] // selected friend user IDs; empty array = no friends
  include_community     Boolean  @default(false) // include Joshing Community questions
  selected_domains      String[] // canonical_subcategory strings; empty = random/all
  difficulty_preference String   @default("normal") // normal | moderate | challenging | ridiculous | adaptive
  updated_at            DateTime @updatedAt

  @@index([user_id])
}

// B9 Phase 4: one row per skip. Same "permanent don't-ask-me-again" signal as
// a thumbs_down feedback; the queue builder OR-merges these with QuestionFeedback
// exclusions. Also enforces the per-round 3-skip cap (count rows by queue_id).
model SkippedDailyQuestion {
  id                    String   @id @default(cuid())
  user_id               String
  queue_id              String
  question_id           String?
  generated_question_id String?
  canonical_subcategory String
  skipped_at            DateTime @default(now())

  user               User               @relation(fields: [user_id], references: [id])
  queue              DailyQueue         @relation(fields: [queue_id], references: [id], onDelete: Cascade)
  question           Question?          @relation(fields: [question_id], references: [id])
  generated_question GeneratedQuestion? @relation(fields: [generated_question_id], references: [id])

  @@index([user_id])
  @@index([user_id, question_id])
  @@index([user_id, generated_question_id])
  @@index([queue_id])
}

// ─────────────────────────────────────────────────────────────────────────────
// ADAPTIVE DIFFICULTY (bidirectional per-domain serving preference)
// ─────────────────────────────────────────────────────────────────────────────

model UserDomainDifficulty {
  id                    String             @id @default(cuid())
  user_id               String
  canonical_subcategory String
  served_difficulty     DifficultyEstimate
  consecutive_correct   Int                @default(0)
  consecutive_incorrect Int                @default(0)
  last_updated          DateTime           @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@unique([user_id, canonical_subcategory])
  @@index([user_id])
  @@map("USER_DOMAIN_DIFFICULTY")
}


model UserDomainExclusion {
  id                    String   @id @default(cuid())
  user_id               String
  canonical_subcategory String
  excluded_at           DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@unique([user_id, canonical_subcategory])
  @@map("USER_DOMAIN_EXCLUSIONS")
}
