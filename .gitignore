# Dependencies
node_modules/

# Next.js
.next/
out/

# Environment variables — never commit secrets
.env
.env.local
.env.*.local

# Vercel
.vercel/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Local dev outputs / stray scratch files (F4.3)
dev-out.txt
dev-stderr.txt
.drizzle-tmp/

# TypeScript incremental build cache
*.tsbuildinfo

# Local Claude overrides & scratch
.claude/settings.local.json
# Git worktrees for other branches are created in here. They are working
# copies, never source: committing one would duplicate the entire repo, and
# vitest already has to exclude the directory to avoid collecting every test
# file once per branch (see vitest.config.ts).
.claude/worktrees/
audits/
supabase/
_scratch/

# MCP config (contains Supabase access token)
.mcp.json

# Auto-generated by Next.js on every build; it rewrites the .next path
# reference and reappears in every diff. Next recommends ignoring it.
next-env.d.ts
